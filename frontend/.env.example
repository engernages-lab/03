# PocketScore AI - frontend environment template (V1.1-C.2)
# Copy to `frontend/.env.local` (git-ignored). Only VITE_* values reach the
# browser bundle - never put a secret here.

# Backend origin. Leave empty when the API is served from the same origin
# (single-service deploy) or when using the Vite dev proxy.
# GitHub Pages builds MUST set this, otherwise every API call 404s.
# VITE_API_BASE_URL=https://<service>.up.railway.app

# Vite dev-server proxy target (development only).
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Sub-path the app is served from (GitHub Pages uses /03/).
# VITE_BASE_PATH=/03/
