# PocketScore AI - backend environment template (V1.1-C.2)
# Copy to `backend/.env` (git-ignored). Every setting is read with POCKETSCORE_.
# NEVER commit real keys.

# ---- application ----
POCKETSCORE_ENVIRONMENT=development        # development | test | staging | production
POCKETSCORE_DEBUG=true
POCKETSCORE_LOG_LEVEL=INFO
POCKETSCORE_LOG_JSON=false
POCKETSCORE_RELEASE_STAGE=V1.1-C.2

# ---- server ----
# Railway injects PORT itself; the container command reads it. This value is
# only used when running uvicorn directly on a host.
POCKETSCORE_HOST=127.0.0.1
POCKETSCORE_PORT=8000
# Comma separated browser origins. production/staging reject "*".
POCKETSCORE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- persistence (SQLite + volume for V1.1-C.2; PostgreSQL is C.3) ----
POCKETSCORE_DATABASE_URL=sqlite:///./data/pocketscore.db
POCKETSCORE_STORAGE_DIR=./data/storage

# ---- uploads ----
POCKETSCORE_MAX_UPLOAD_MB=100
POCKETSCORE_MAX_AUDIO_DURATION_SECONDS=600

# ---- inference capacity ----
POCKETSCORE_MAX_CONCURRENT_INFERENCES=1
POCKETSCORE_INFERENCE_QUEUE_TIMEOUT_SECONDS=30
POCKETSCORE_INFERENCE_TIMEOUT_SECONDS=300
# true = load the model and run one warm-up inference during startup
POCKETSCORE_MODEL_PRELOAD=false

# ---- security (staging/production REQUIRE the first two) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POCKETSCORE_TOKEN_ENCRYPTION_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
POCKETSCORE_SESSION_SECRET=change-me-in-production
# Must be false outside a trusted LAN (SSRF surface).
POCKETSCORE_ALLOW_PRIVATE_NETWORK_SOURCES=true

# ---- optional music platforms (not required to boot) ----
POCKETSCORE_NAVIDROME_DEFAULT_URL=
POCKETSCORE_APPLE_MUSIC_TEAM_ID=
POCKETSCORE_APPLE_MUSIC_KEY_ID=
POCKETSCORE_APPLE_MUSIC_PRIVATE_KEY_PATH=
POCKETSCORE_SPOTIFY_CLIENT_ID=
POCKETSCORE_SPOTIFY_CLIENT_SECRET=
