# ---- Playwright HTML report (generated) ----
tests/e2e/report/

# ---- PocketScore runtime data (never committed) ----
backend/data/
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
uploads/
storage/

# ---- Secrets / local config ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Tests / tooling artefacts ----
playwright-report/
test-results/
blob-report/
.playwright/
coverage/
*.log
# pytest temp dirs (basetemp is pinned in backend/pytest.ini)
pytest-of-*/
.pytest-tmp/
backend/pytest-of-*/
backend/.pytest-tmp/

# ---- Private keys (Apple .p8, TLS certs) ----
*.p8
*.p12

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# TypeScript incremental build info (generated by tsc)
*.tsbuildinfo
