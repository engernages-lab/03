# ==========================================================================
# PocketScore AI - environment template
# Copy to `.env` (git-ignored) and fill in what you need.
# Every backend setting is read with the POCKETSCORE_ prefix.
# ==========================================================================

# ---- application ----
POCKETSCORE_ENVIRONMENT=development
POCKETSCORE_DEBUG=true
POCKETSCORE_LOG_LEVEL=INFO
POCKETSCORE_LOG_JSON=false

# ---- server ----
POCKETSCORE_HOST=127.0.0.1
POCKETSCORE_PORT=8000
# Comma separated list of allowed browser origins (CORS).
POCKETSCORE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- persistence ----
POCKETSCORE_DATABASE_URL=sqlite:///./data/pocketscore.db
POCKETSCORE_STORAGE_DIR=./data/storage

# ---- uploads ----
POCKETSCORE_MAX_UPLOAD_MB=200

# ---- security ----
# Fernet key (32 url-safe base64 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in development to use a machine-local generated key file.
POCKETSCORE_TOKEN_ENCRYPTION_KEY=
POCKETSCORE_SESSION_SECRET=change-me-in-production
# Set to false to forbid private/LAN music servers (hardens SSRF surface).
POCKETSCORE_ALLOW_PRIVATE_NETWORK_SOURCES=true

# ---- Navidrome / OpenSubsonic (optional default, users can add their own) ----
POCKETSCORE_NAVIDROME_DEFAULT_URL=

# ---- Apple Music (MusicKit on the web) ----
POCKETSCORE_APPLE_MUSIC_TEAM_ID=
POCKETSCORE_APPLE_MUSIC_KEY_ID=
# Path to the .p8 private key downloaded from Apple Developer.
POCKETSCORE_APPLE_MUSIC_PRIVATE_KEY_PATH=
POCKETSCORE_APPLE_MUSIC_STOREFRONT=us

# ---- Spotify (metadata only; AI transcription is policy-restricted) ----
POCKETSCORE_SPOTIFY_CLIENT_ID=
POCKETSCORE_SPOTIFY_CLIENT_SECRET=
POCKETSCORE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/sources/spotify/callback

# ==========================================================================
# Frontend (Vite) - prefix VITE_
# ==========================================================================
# Leave empty to use the Vite dev proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://127.0.0.1:8000
